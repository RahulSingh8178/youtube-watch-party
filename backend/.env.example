# Port the server listens on
PORT=4000

# MongoDB connection string. Room persistence is optional -
# if this is left empty or the connection fails, the server
# falls back to in-memory-only rooms (everything still works,
# rooms just won't survive a server restart).
MONGODB_URI=mongodb://localhost:27017/watch-party

# Comma-separated list of allowed frontend origins for CORS + Socket.IO
CLIENT_ORIGIN=http://localhost:5173
